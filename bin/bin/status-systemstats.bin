#!/usr/bin/env zsh

cputemp="CPU: $(sensors | awk '/Tctl/ {print $2}')"
battery=$( acpi -b | awk '{print $4}')
rate="rate:$(upower -d |awk '/^\s*energy-rate:/ { print $2; exit }')"
asus_profile=$( asusctl profile get | awk -F': ' '/Active profile/ {print $2}')

# send it to dwmblocks
echo $cputemp $battery $rate $asus_profile


